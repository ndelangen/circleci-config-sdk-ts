{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "stripInternal": true,
    "strict": true,
    "resolveJsonModule": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.d.ts"]
}
