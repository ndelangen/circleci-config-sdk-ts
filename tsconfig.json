{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "stripInternal": true,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"]
  },
  "include": ["src/**/*.ts", "**/*.test.ts"],
  "exclude": ["node_modules", "**/*.d.ts"]
}
